# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=OdontoLink
VITE_APP_VERSION=1.0.0

# ---- Appearance (build-time defaults) -------------------------------------
# These set the *fallback* values used when the user has no localStorage
# preference AND the institutional siteConfig from the backend has not
# loaded yet. After the first paint they are overridden by either the
# admin-applied institutional theme (server) or the user's stored
# preference. To change the institutional theme for all users in
# production, prefer the admin panel at /admin/appearance instead of these.

# Default theme variant id. Slug of any built-in (theme-1..theme-26 or
# odontolink-original) or a custom theme created via /admin/appearance
# (slugs of the form `custom-<name>`). Required for the boot-colour
# substitution in index.html — sets the colours the browser paints
# BEFORE React mounts, so the first frame already matches the env theme.
VITE_THEME_VARIANT=theme-26

# Default font pair id. One of: inter-source-jetbrains, geist-geist,
# outfit-inter-jetbrains, plus-jakarta-inter-jetbrains, dm-sans-dm-mono,
# manrope-inter-jetbrains.
VITE_FONT_PAIR=inter-source-jetbrains

# Default colour mode for first-time visitors: light | dark | system.
VITE_THEME_MODE=system

# Home page Hero animation variant: scatter | split | marquee.
VITE_HERO_VARIANT=scatter
